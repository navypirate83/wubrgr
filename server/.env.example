# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=4100
# Your MongoDB Atlas connection string (the database name goes after the last slash)
MONGODB_URI=
# A long random text. Make one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it later signs everybody out. Use a DIFFERENT one from other projects.
JWT_SECRET=
# The app's Google client id(s), separated by commas (used to check Google tokens)
GOOGLE_CLIENT_ID=
# Signing in to an account with Google is SWITCHED OFF unless this says "on" (leave it empty to keep it off).
# Keep GOOGLE_CLIENT_ID filled in either way, so it is ready if Google sign-in comes back.
GOOGLE_LOGIN=
# Websites allowed to call this server from a browser, exact addresses separated
# by commas (https, host and port only, no trailing slash). "*" is never allowed.
CORS_ORIGINS=
# Optional: how many relays (proxies) sit between a visitor and the server. Leave it out on Render
# (3, measured there). Only set it if the server moves to a different host.
# TRUST_PROXY=3
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
# Optional: sign-up tries one visitor gets per hour (10 if left out)
# SIGNUP_HOURLY_MAX=10
# Optional: where the automated tests run (the name must end in "test")
# MONGODB_TEST_URI=
TEST_DB_NAME=wubgr-test

# Email for "Forgot username/password" and the welcome email to new people
# (Resend: https://resend.com, free plan). Leave both empty to switch email
# off (the reset route then answers 503, and no welcome email is sent).
# MAIL_FROM looks like: WUBRG'r <hello@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=
# The website's address, used for the link in the welcome email (optional;
# it defaults to the GitHub Pages address)
APP_URL=
